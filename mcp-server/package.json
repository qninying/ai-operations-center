{
  "name": "coreops-mcp-server",
  "version": "0.1.0",
  "description": "CoreOps MCP Tool Gateway — read-only stdio MCP server exposing SQL Server DMV data to AI agents.",
  "private": true,
  "type": "module",
  "main": "dist/mcp-server/src/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "http": "tsx src/httpServer.ts",
    "http-mcp": "tsx src/httpMcpServer.ts",
    "build": "tsc",
    "start": "node dist/mcp-server/src/index.js",
    "test": "vitest run",
    "hash-password": "tsx src/auth/hashPassword.ts",
    "build-console": "npm run build --prefix ../frontend"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@azure/storage-blob": "^12.28.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mssql": "^12.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
