# Copy to .env and fill in for a real SQL Server connection.
# Never commit .env — see repo-root .gitignore.
#
# The account behind these credentials must be read-only (least-privilege),
# per the security notes in project-blueprint/architecture.md: the Execution
# Service is the only component in the AIOps design that may ever hold a
# write-capable credential, and this MCP server is not the Execution Service.
#
# If any of these are unset, or the connection fails, the DMV read tool falls
# back to fixture data automatically (see mcp-server/src/dmvReader.ts) —
# there's no hard failure from missing config alone.

SQLSERVER_HOST=
SQLSERVER_DATABASE=
SQLSERVER_USER=
SQLSERVER_PASSWORD=

# Anthropic API key for the Root Cause Analysis Agent (STORY-003 / R1), per
# project-blueprint/architecture.md's Components table: "Claude Sonnet 5
# (Anthropic API) + MCP Tool Gateway (read path)". Never commit .env.
ANTHROPIC_API_KEY=

# Copy to .env and fill in for real Azure Blob Storage access (STORY-007).
# Read-only least-privilege credential only — same rule as SQLSERVER_* above.
# If unset, or the connection fails, the cloud data path surfaces an honest
# connectivity notification — it does not fall back to fixture-as-real.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# Comma-separated operator contacts for STORY-010's autonomous-action notifications.
# Names who the notification is "for" in its audit log — not the delivery address
# itself (see NTFY_TOPIC below for that). If unset or empty, notifyOperators() throws
# OperatorContactMissingError immediately rather than silently notifying nobody.
OPERATOR_CONTACTS=

# Real delivery channel: a free ntfy.sh push topic (no signup, no API key — see
# https://ntfy.sh/docs/). The topic name is the only "credential" — anyone who knows
# it can publish or subscribe, so use an unguessable value, not something like
# "coreops-alerts". If unset, notifications fail closed (logged, never silently
# dropped) rather than falling back to a fake success.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Single-operator login for the dashboard/API. Both are required — httpServer.ts
# fails fast at startup if either is unset (a deliberate exception to this file's
# usual "missing config -> fall back gracefully" convention: falling back here would
# mean silently serving with no real auth). Generate the hash once:
#   npm run hash-password -- '<your password>'
# and paste the printed "salt:hash" value below. AUTH_PASSWORD is the same password
# in plaintext, needed only so the demo-start/demo-stop skills can log in
# non-interactively via curl — the hash alone can't be used to authenticate. This is
# consistent with how every other operational secret in this file already lives in
# plaintext .env (SQLSERVER_PASSWORD, AZURE_STORAGE_CONNECTION_STRING,
# ANTHROPIC_API_KEY): the threat model here is a network-reachable attacker, not
# someone who already has filesystem access to this gitignored file.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_PASSWORD=

# Real TOTP-based MFA (RFC 6238) — httpServer.ts fails fast at startup if unset,
# same deliberate exception to "missing config -> fall back gracefully" as
# AUTH_USERNAME/AUTH_PASSWORD_HASH above: starting with no real second factor would
# mean silently serving with the guardrail's MFA check permanently satisfied by a
# hardcoded true. Generate once:
#   npm run generate-totp-secret
# and paste the printed secret below, then enter it into an authenticator app
# (manual entry, or the printed otpauth:// URI) — once. Same plaintext-in-.env
# threat model as every other secret in this file: the risk is a network-reachable
# attacker, not someone who already has filesystem access to this gitignored file.
MFA_TOTP_SECRET=

# Set to "true" only for a real, non-localhost HTTPS deployment — appends the Secure
# flag to the session cookie. Defaults off so plain http://localhost:8787 keeps
# working with zero setup; this plain http.Server has no TLS awareness to infer it
# from automatically, so turning it on is a deliberate deploy-time choice.
SESSION_COOKIE_SECURE=false

# ADR-001/ADR-004: the bearer token that gates httpMcpServer.ts, the network-facing
# StreamableHTTP MCP transport (npm run http-mcp). This is a machine credential, not
# a human password — MCP callers are services/agents, not a browser, so this is
# deliberately separate from AUTH_USERNAME/AUTH_PASSWORD_HASH above. httpMcpServer.ts
# fails fast at startup if unset, same reasoning as AUTH_USERNAME/AUTH_PASSWORD_HASH:
# starting with no real token would silently expose every DMV read tool to anyone
# who can reach the port. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_API_TOKEN=
MCP_HTTP_PORT=8788
